<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PptAgentStudio_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PptAgentStudio_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:PptAgentStudio_App.ViewModels"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="PaneBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </Page.Resources>

    <Grid Padding="16" ColumnDefinitions="*,12,460" RowDefinitions="Auto,*">
        <CommandBar Grid.ColumnSpan="3" DefaultLabelPosition="Right" Background="Transparent">
            <AppBarButton Icon="Add" Label="New Deck" />
            <AppBarButton Icon="Save" Label="Export" />
            <AppBarSeparator />
            <AppBarButton Icon="Setting" Label="Settings" />
        </CommandBar>

        <Border Grid.Row="1" Style="{StaticResource PaneBorderStyle}" Padding="16">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                <StackPanel Spacing="4">
                    <TextBlock Text="Agent Workspace" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.SessionStatus, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <ListView
                    Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.Messages, Mode=OneWay}"
                    SelectionMode="None"
                    Padding="0">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChatMessageItem">
                            <Grid Margin="0,0,0,10">
                                <Border
                                    Padding="12"
                                    CornerRadius="8"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{x:Bind Role}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind Content}" TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox
                        Text="{x:Bind ViewModel.InputText, Mode=TwoWay}"
                        PlaceholderText="Ask for a board-ready deck..."
                        AcceptsReturn="True"
                        MinHeight="48"
                        TextWrapping="Wrap" />
                    <Button
                        Grid.Column="1"
                        MinWidth="96"
                        Command="{x:Bind ViewModel.SendCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE724;" FontSize="14" />
                            <TextBlock Text="Send" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource PaneBorderStyle}" Padding="0">
            <Grid RowDefinitions="Auto,*">
                <CommandBar DefaultLabelPosition="Collapsed" Background="Transparent">
                    <AppBarButton Icon="Back" Label="Previous" />
                    <AppBarButton Icon="Forward" Label="Next" />
                    <AppBarSeparator />
                    <AppBarButton Icon="Zoom" Label="Zoom" />
                </CommandBar>

                <Border Grid.Row="1" Padding="24" Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">
                    <Grid>
                        <Border
                            MaxWidth="720"
                            MaxHeight="405"
                            Width="420"
                            Height="236"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="White"
                            CornerRadius="8"
                            Padding="32">
                            <StackPanel Spacing="16">
                                <TextBlock Text="Board AI Strategy" FontSize="30" FontWeight="SemiBold" />
                                <TextBlock Text="Live preview placeholder" FontSize="18" Foreground="#555555" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
