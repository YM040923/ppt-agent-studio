<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PptAgentStudio_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PptAgentStudio_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:markdown="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:PptAgentStudio_App.ViewModels"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="PaneBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </Page.Resources>

    <Grid Padding="16" ColumnDefinitions="*,12,460" RowDefinitions="Auto,*">
        <CommandBar Grid.ColumnSpan="3" DefaultLabelPosition="Right" Background="Transparent">
            <AppBarButton Icon="Add" Label="New Deck" Command="{x:Bind ViewModel.NewDeckCommand}" />
            <AppBarButton Icon="Play" Label="Demo Deck" Command="{x:Bind ViewModel.GenerateDemoCommand}" />
            <AppBarButton Icon="Cancel" Label="Cancel" Command="{x:Bind ViewModel.CancelCommand}" />
            <AppBarButton Icon="OpenFile" Label="Open PPTX" Command="{x:Bind ViewModel.ExportLatestCommand}" />
            <AppBarSeparator />
            <AppBarButton Icon="Setting" Label="Settings" Click="Settings_Click" />
        </CommandBar>

        <Border Grid.Row="1" Style="{StaticResource PaneBorderStyle}" Padding="16">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                <StackPanel Spacing="4">
                    <TextBlock Text="Agent Workspace" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.SessionStatus, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords" />
                </StackPanel>

                <ListView
                    Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.Messages, Mode=OneWay}"
                    SelectionMode="None"
                    Padding="0">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChatMessageItem">
                            <Grid Margin="0,0,0,10">
                                <Border
                                    Padding="12"
                                    CornerRadius="8"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{x:Bind Role}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <markdown:MarkdownTextBlock Text="{x:Bind Content}" />
                                        <ItemsControl ItemsSource="{x:Bind Actions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ChatMessageAction">
                                                    <Button
                                                        Content="{x:Bind Label}"
                                                        Tag="{x:Bind Kind}"
                                                        Click="ChatMessageAction_Click" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox
                        Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Ask for a board-ready deck..."
                        AcceptsReturn="True"
                        MinHeight="48"
                        TextWrapping="Wrap" />
                    <Button
                        Grid.Column="1"
                        MinWidth="96"
                        Command="{x:Bind ViewModel.SendCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE724;" FontSize="14" />
                            <TextBlock Text="Send" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource PaneBorderStyle}" Padding="0">
            <Grid RowDefinitions="Auto,*">
                <CommandBar DefaultLabelPosition="Collapsed" Background="Transparent">
                    <AppBarButton x:Name="PreviewPreviousButton" Icon="Back" Label="Previous" Click="PreviewPrevious_Click" />
                    <AppBarButton x:Name="PreviewNextButton" Icon="Forward" Label="Next" Click="PreviewNext_Click" />
                    <AppBarElementContainer>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,0,10,0">
                            <TextBlock x:Name="PreviewPageText" Text="0 / 0" VerticalAlignment="Center" />
                            <TextBlock x:Name="PreviewZoomText" Text="100%" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </AppBarElementContainer>
                    <AppBarSeparator />
                    <AppBarButton x:Name="PreviewZoomOutButton" Icon="Remove" Label="Zoom out" Click="PreviewZoomOut_Click" />
                    <AppBarButton x:Name="PreviewZoomResetButton" Icon="Zoom" Label="Reset zoom" Click="PreviewZoomReset_Click" />
                    <AppBarButton x:Name="PreviewZoomInButton" Icon="Add" Label="Zoom in" Click="PreviewZoomIn_Click" />
                </CommandBar>

                <controls:WebView2
                    x:Name="PreviewWebView"
                    Grid.Row="1"
                    Source="about:blank"
                    NavigationCompleted="PreviewWebView_NavigationCompleted"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />
            </Grid>
        </Border>
    </Grid>
</Page>
