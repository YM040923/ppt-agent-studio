# Copy to .env.local and fill with your local or third-party OpenAI-compatible provider.
# Never commit .env.local or real API keys.

OPENAI_BASE_URL=https://your-provider.example/v1
OPENAI_API_KEY=replace-with-your-api-key
OPENAI_MODEL=your-compatible-model

# Cloud OpenAI-compatible example:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4.1-mini
#
# Local model server examples:
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_BASE_URL=http://modelbox.local:8000/v1
# OPENAI_MODEL=local-compatible-model

# Optional JSON object for OpenAI-compatible gateways that require extra headers.
# Example: {"X-Provider":"tenant-id"}
OPENAI_EXTRA_HEADERS=

# fallback keeps the MVP deterministic and offline.
# llm uses the model-backed outline planner when OPENAI_API_KEY is present.
PPT_AGENT_PLANNER=fallback

# Optional Python runtime override for manual server runs.
PPT_AGENT_ARTIFACTS_DIR=artifacts/decks
